# NestJS Server Environment Variables (.env.example)

PORT=4001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── SUPABASE & POSTGRES DATABASE ─────────────────────────────────────────────
# Shared transaction-mode pooler (for runtime queries, pgbouncer=true)
DATABASE_URL="postgresql://postgres.ljvrnyatrtbhdunyhfst:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Shared session-mode pooler (used for Prisma migrations)
DIRECT_URL="postgresql://postgres.ljvrnyatrtbhdunyhfst:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ─── SUPABASE API KEYS & CREDENTIALS ──────────────────────────────────────────
SUPABASE_URL=https://ljvrnyatrtbhdunyhfst.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_17KmYFNDZ8QgWwrLDiqAFQ_SjAHBzq9
SUPABASE_JWKS_URL=https://ljvrnyatrtbhdunyhfst.supabase.co/auth/v1/.well-known/jwks.json

# Redis — required in production unless ALLOW_SINGLE_INSTANCE=true.
#
# It carries two things the app cannot do without across more than one process:
# Socket.IO room broadcasts (otherwise an overlay attached to instance B never
# sees a score change published by instance A, silently and forever), and the
# lease that decides which instance is allowed to run a given battle's clock.
REDIS_URL=redis://:redis_secret@localhost:6379

# Set only if this deployment genuinely runs exactly one server process.
# Two processes with this on and no Redis will double the energy refill rate,
# overwrite each other's scores every two seconds, and freeze half the overlays.
# ALLOW_SINGLE_INSTANCE=true

# Identifies this process in battle ownership leases. Leave unset outside of
# debugging — the default is random per boot, which is what you want: a
# restarted process must not inherit a lease protecting state that died with it.
# INSTANCE_ID=

# Auth & JWT
JWT_SECRET=change_me_to_a_secure_random_string_32_chars_min
JWT_REFRESH_SECRET=change_me_to_another_secure_random_string_32_chars_min
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# TTS Engine
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key

# Cloudflare Turnstile — bat buoc o production (hoac dat ALLOW_NO_TURNSTILE=true).
# Lay o dashboard Turnstile; KHONG commit gia tri that vao repo.
TURNSTILE_SECRET=
