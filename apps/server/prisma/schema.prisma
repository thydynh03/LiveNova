generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum BattleStatus {
  RUNNING
  FINISHED
  CANCELLED
}

enum TemplateKind {
  GAME
  MEDIA_PACK
  RULE_PACK
}

/// Engine chạy template loại GAME. Hiện chỉ có một.
enum GameMode {
  TEAM_BATTLE
}

enum ProviderType {
  GOOGLE
  FACEBOOK
  ZALO
  LOCAL
}

enum Platform {
  TIKTOK
  FACEBOOK
  YOUTUBE
}

enum LedgerReason {
  PURCHASE
  TTS_SYNTHESIS
  DAILY_QUOTA
  REFUND
  ADMIN_ADJUST
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum OverlayType {
  ALERTS
  CHAT
  GOAL
  PK_BAR
  LEADERBOARD
  ROOM_ENTRY
  MEDIA
  GAME_BATTLE
  STAGE
}

enum LiveEventType {
  GIFT
  CHAT
  LIKE
  JOIN
  SHARE
  FOLLOW
}

enum OtpType {
  REGISTER
  FORGOT_PASSWORD
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  displayName   String?
  avatar        String?
  role          Role      @default(USER)
  // L10N-07 / B.8.1 — VN-first defaults. Drives BR-06 daily quota reset.
  locale        String    @default("vi")
  timezone      String    @default("Asia/Ho_Chi_Minh")
  passwordHash  String?
  emailVerified Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  identities    Identity[]
  sessions      Session[]
  channels      Channel[]
  creditBalance CreditBalance?
  creditLedger  CreditLedger[]
  transactions  Transaction[]
  rules         Rule[]
  overlays      Overlay[]
  userTemplates UserTemplate[]
  battles       Battle[]
  templatesMade Template[]      @relation("TemplateAuthor")
  adminActions  AdminAuditLog[] @relation("AdminActor")
  actionsOnMe   AdminAuditLog[] @relation("AdminTarget")
  liveSessions  LiveSession[]
  ttsSettings   TtsSettings?
  gameProfiles  GameProfile[]
  otpCodes      OtpCode[]

  @@index([deletedAt])
}

model Identity {
  id              String       @id @default(uuid())
  userId          String
  provider        ProviderType
  providerUserId  String
  emailVerified   Boolean      @default(false)
  accessTokenEnc  Bytes?
  refreshTokenEnc Bytes?
  createdAt       DateTime     @default(now())
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // H-02: OAuth lookup MUST be by (provider, providerUserId), never by email alone.
  @@unique([provider, providerUserId])
  @@index([userId])
}

/// C-06 / FR-006..FR-008 — refresh tokens are server-side records so they can be
/// rotated and revoked. `familyId` groups a rotation chain: reusing an already-rotated
/// token revokes the whole family (reuse detection).
model Session {
  id          String    @id @default(uuid())
  userId      String
  refreshHash String    @unique
  familyId    String
  ip          String?
  userAgent   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

/// H-07 / FR-011, FR-012 — a channel must be owned and ownership-verified before
/// any ingest or socket subscription is permitted (fixes C-04).
model Channel {
  id                String        @id @default(uuid())
  userId            String
  platform          Platform      @default(TIKTOK)
  platformChannelId String
  handle            String
  avatarUrl         String?
  broadcastSource   String?
  verified          Boolean       @default(false)
  verificationCode  String?
  isLive            Boolean       @default(false)
  lastLiveAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  liveSessions      LiveSession[]

  // BR-16 — one platform channel may be linked to exactly one account.
  @@unique([platform, platformChannelId])
  @@index([userId])
}

model CreditBalance {
  id            String    @id @default(uuid())
  userId        String    @unique
  /// H-08 — a DB-level CHECK (balance >= 0) is added by
  /// prisma/sql/001_constraints.sql. Prisma cannot express CHECK natively.
  balance       Int       @default(0)
  dailyFreeUsed Int       @default(0)
  resetsAt      DateTime?
  version       BigInt    @default(0)
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditLedger {
  id           String       @id @default(uuid())
  userId       String
  delta        Int
  reason       LedgerReason
  description  String?
  balanceAfter Int
  refId        String?
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Transaction {
  id             String            @id @default(uuid())
  userId         String
  idempotencyKey String            @unique
  amountMinor    BigInt
  creditAmount   Int
  status         TransactionStatus @default(PENDING)
  provider       String
  providerTxnId  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerTxnId])
  @@index([userId, createdAt])
}

model Rule {
  id               String   @id @default(uuid())
  userId           String
  name             String
  enabled          Boolean  @default(true)
  priority         Int      @default(0)
  conditions       Json
  actions          Json
  continueMatching Boolean  @default(false)
  cooldownMs       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled, priority])
}

model Overlay {
  id          String      @id @default(uuid())
  userId      String
  type        OverlayType
  /// M-08 — 256-bit random, generated in OverlayService (not uuid()).
  publicToken String      @unique
  config      Json
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LiveSession {
  id            String      @id @default(uuid())
  userId        String
  channelId     String
  startedAt     DateTime    @default(now())
  endedAt       DateTime?
  totalViewers  Int         @default(0)
  totalCoins    Int         @default(0)
  totalComments Int         @default(0)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel       Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  events        LiveEvent[]

  @@index([channelId, startedAt])
}

model LiveEvent {
  id                String        @id @default(uuid())
  sessionId         String
  type              LiveEventType
  senderUsername    String
  senderDisplayName String
  content           String?
  giftName          String?
  giftCoinValue     Int?
  occurredAt        DateTime      @default(now())
  session           LiveSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, occurredAt])
  @@index([type, occurredAt])
}

/// H-06 — cache key is sha256 (not md5). `expiresAt` implements DR-03 (30-day TTL).
model TtsCache {
  cacheKey   String   @id
  audioUrl   String
  durationMs Int?
  hitCount   Int      @default(0)
  createdAt  DateTime @default(now())
  lastHitAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}

model TtsSettings {
  userId      String   @id
  voiceId     String   @default("vi-VN-Wavenet-A")
  rate        Float    @default(1.0)
  pitch       Float    @default(0)
  volume      Float    @default(1.0)
  bannedWords String[] @default([])
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// FR-054..FR-056 / BR-25 — safety limits live in the DB so the desktop client
/// is not the only thing enforcing them.
model GameProfile {
  id                  String        @id @default(uuid())
  userId              String
  gameName            String
  enabled             Boolean       @default(true)
  maxActionsPerMinute Int           @default(20)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bindings            GameBinding[]

  @@index([userId])
}

model GameBinding {
  id            String      @id @default(uuid())
  profileId     String
  triggerGiftId String
  keyCode       Int
  durationMs    Int         @default(100)
  cooldownMs    Int         @default(3000)
  profile       GameProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  type      OtpType  @default(REGISTER)
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [email], references: [email], onDelete: Cascade)

  @@index([email, type])
}

/// ─────────────────────────────────────────────────────────────────────────────
/// Template — bộ cấu hình do admin soạn, streamer chọn và áp dụng.
///
/// Đây là bản tổng quát của `RuleService.applyPreset`, vốn viết cứng 3 preset
/// trong file .ts. Đưa vào DB để admin thêm chủ đề mới mà không cần lập trình.
/// ─────────────────────────────────────────────────────────────────────────────
model Template {
  id             String       @id @default(uuid())
  kind           TemplateKind
  /// Chỉ có giá trị khi kind = GAME.
  gameMode       GameMode?
  /// Định danh ổn định cho mẫu do seed tạo: chạy seed lại không nhân bản, và
  /// endpoint preset cũ vẫn tra được. Mẫu admin tự tạo thì để trống.
  slug           String?      @unique
  name           String
  description    String?
  thumbnailUrl   String?
  /// Cấu hình engine hoặc bộ luật. Hình dạng tuỳ theo `kind`.
  config         Json
  /// Trường nào streamer được sửa sau khi áp dụng. Ngoài danh sách là admin khoá.
  editableFields String[]     @default([])
  /// Chưa publish thì chỉ admin thấy.
  published      Boolean      @default(false)
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  createdBy User            @relation("TemplateAuthor", fields: [createdById], references: [id])
  assets    TemplateAsset[]
  applied   UserTemplate[]

  @@index([kind, published])
}

/// Media của một template. `config` trỏ vào `key`, không nhúng URL, để đổi
/// asset không phải sửa config.
model TemplateAsset {
  id         String   @id @default(uuid())
  templateId String
  /// Khoá logic: "fx_dragon", "castle_cat".
  key        String
  url        String
  mediaType  String
  createdAt  DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
}

/// Bản sao template lúc streamer áp dụng.
///
/// Cố ý là bản sao, không phải tham chiếu: admin sửa template gốc không được
/// làm đổi cấu hình của streamer đang live.
model UserTemplate {
  id         String   @id @default(uuid())
  userId     String
  /// Nguồn gốc — để biết template nào đang được bao nhiêu người dùng.
  templateId String
  name       String
  config     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id])

  @@index([userId])
  @@index([templateId])
}

/// Nhật ký hành động của admin.
///
/// Không có bảng này thì "tự dưng mất credit" là câu hỏi không ai trả lời được.
model AdminAuditLog {
  id           String   @id @default(uuid())
  adminId      String
  /// Người bị tác động, nếu có.
  targetUserId String?
  action       String
  /// Chi tiết đủ để dựng lại chuyện gì đã xảy ra.
  detail       Json
  createdAt    DateTime @default(now())

  admin      User  @relation("AdminActor", fields: [adminId], references: [id])
  targetUser User? @relation("AdminTarget", fields: [targetUserId], references: [id])

  @@index([adminId, createdAt])
  @@index([targetUserId, createdAt])
}

/// ─────────────────────────────────────────────────────────────────────────────
/// Một lượt chơi Kingdom War.
///
/// Điểm phải nằm ở DB chứ không chỉ trong RAM: một trận có đồng hồ và có người
/// thắng, mà người xem đã bỏ tiền thật để tác động vào kết quả. Deploy giữa
/// trận mà mất sạch điểm là chuyện streamer không giải thích được với khán giả.
/// ─────────────────────────────────────────────────────────────────────────────
model Battle {
  id             String       @id @default(uuid())
  userId         String
  templateId     String?
  title          String
  status         BattleStatus @default(RUNNING)
  /// Ảnh chụp cấu hình lúc bắt đầu: sửa mẫu giữa trận không đổi luật trận đang chạy.
  configSnapshot Json
  startedAt      DateTime     @default(now())
  endsAt         DateTime
  finishedAt     DateTime?
  winnerTeamKey  String?

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores BattleScore[]
  donors BattleDonor[]

  @@index([userId, status])
}

model BattleScore {
  battleId     String
  teamKey      String
  score        Int    @default(0)
  castleHp     Int    @default(1000)
  soldierCount Int    @default(0)

  battle Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@id([battleId, teamKey])
}

model BattleDonor {
  battleId   String
  username   String
  nickname   String
  teamKey    String
  totalScore Int    @default(0)

  battle Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@id([battleId, username])
  @@index([battleId, totalScore])
}

/// ─────────────────────────────────────────────────────────────────────────────
/// Lưu lượng web.
///
/// Đo bằng bảng của chính mình chứ không nhúng Google Analytics: trang này có
/// người dùng ở EU, và một thẻ script bên thứ ba đọc được toàn bộ hành vi của họ
/// là chuyện phải xin phép — trong khi tất cả những gì cần trả lời chỉ là "hôm
/// nay bao nhiêu người vào, xem gì, ở lại bao lâu".
///
/// Không lưu IP, không lưu user-agent thô, không đặt cookie. `visitorId` là một
/// chuỗi ngẫu nhiên nằm trong sessionStorage của trình duyệt: nó phân biệt được
/// hai phiên khác nhau trong cùng một ngày, và biến mất khi đóng tab. Đủ để đếm
/// phiên, không đủ để theo dõi một con người qua thời gian — đó là chủ ý.
/// ─────────────────────────────────────────────────────────────────────────────
enum WebEventKind {
  /// Mở một trang.
  VIEW
  /// Bấm vào thứ có gắn `data-track`.
  CLICK
  /// Rời một trang, kèm số giây đã ở lại.
  LEAVE
}

model WebEvent {
  id        String       @id @default(uuid())
  kind      WebEventKind
  /// Đường dẫn, đã bỏ query string. Query có thể chứa token đặt lại mật khẩu.
  path      String
  /// Nhãn của thứ được bấm, chỉ có với CLICK.
  label     String?
  /// Số giây ở lại trang, chỉ có với LEAVE.
  dwellMs   Int?
  /// Tên miền giới thiệu, không phải URL đầy đủ — đủ để biết khách tới từ
  /// Google hay từ TikTok, không đủ để dựng lại họ vừa đọc gì ở bên kia.
  referrer  String?
  /// Phân loại thô từ user-agent: 'mobile' | 'desktop' | 'bot'.
  device    String?
  /// Phiên trình duyệt ẩn danh. Xem chú thích ở trên.
  visitorId String
  createdAt DateTime     @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([visitorId, createdAt])
  @@index([kind, createdAt])
}
