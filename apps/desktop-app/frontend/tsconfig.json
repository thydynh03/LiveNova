{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    // The wailsjs/**/*.js bindings are generated, untyped, and not ours to fix;
    // their .d.ts siblings are what we type-check against.
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "wailsjs/**/*.ts", "wailsjs/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
