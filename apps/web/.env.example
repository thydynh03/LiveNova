# Next.js Web App Environment Variables (.env.example)

NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_WS_URL=ws://localhost:4001
NEXT_PUBLIC_LOCAL_BRIDGE_URL=ws://127.0.0.1:4000

# Supabase Client Credentials
NEXT_PUBLIC_SUPABASE_URL=https://ljvrnyatrtbhdunyhfst.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_17KmYFNDZ8QgWwrLDiqAFQ_SjAHBzq9

# Origin cong khai cua web. Bat buoc cho ban build production — thieu no thi
# sitemap, canonical va og:url se tro ve localhost tren trang that.
NEXT_PUBLIC_SITE_URL=https://livenova.website

# Cloudflare Turnstile — site key la cong khai (no nam trong HTML ai cung doc duoc).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAELNoz09Q8Ne_X2S

# Mo hinh VRM cho nhan vat tren san khau (stage overlay) va Studio VRM trong
# khu quan tri.
#
# Bo trong thi web dung /lab/model.vrm — file do NAM TRONG .gitignore vi ly do
# GIAY PHEP, khong phai dung luong: mo hinh dang dung de do hieu nang tai cho
# ghi ro personal_commercial_use=disallow va corporate_commercial_use=disallow,
# ma LiveNova la san pham thuong mai. No chi ton tai tren may lap trinh.
#
# Ban dung phat hanh BAT BUOC tro sang mot mo hinh co giay phep thuong mai, host
# o noi phuc vu duoc CORS (vi du Supabase Storage). Thieu bien nay tren
# production thi nhan vat khong hien va overlay bao 404.
NEXT_PUBLIC_VRM_MODEL_URL=
