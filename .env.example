# ─────────────────────────────────────────────────────────────────────────────
# LiveNova Monorepo — Master Environment Variable Template (.env.example)
# Copy this file to .env and adjust values for your local environment
# ─────────────────────────────────────────────────────────────────────────────

# ─── DATABASE CONFIGURATION ──────────────────────────────────────────────────
POSTGRES_USER=tiktok_user
POSTGRES_PASSWORD=tiktok_secret
POSTGRES_DB=tiktok_live_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tiktok_user:tiktok_secret@localhost:5432/tiktok_live_db?schema=public

# ─── REDIS CONFIGURATION ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379

# ─── NESTJS SERVER (API & WEBSOCKET) ──────────────────────────────────────────
PORT=4001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── AUTHENTICATION & JWT SECRETS ────────────────────────────────────────────
# Generate 32+ char random strings for production (e.g. openssl rand -base64 32)
JWT_SECRET=change_me_to_a_secure_random_string_32_chars_min
JWT_REFRESH_SECRET=change_me_to_another_secure_random_string_32_chars_min
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── OAUTH PROVIDERS ──────────────────────────────────────────────────────────
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here

# ─── TEXT-TO-SPEECH (TTS) ENGINE ──────────────────────────────────────────────
# Google Cloud Text-to-Speech API Key
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key_here

# ─── PAYMENT GATEWAYS (VNPAY / MOMO) ──────────────────────────────────────────
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key

# ─── NEXT.JS WEB FRONTEND ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_WS_URL=ws://localhost:4001
NEXT_PUBLIC_LOCAL_BRIDGE_URL=ws://127.0.0.1:4000
