# ─────────────────────────────────────────────────────────────────────────────
# LiveNova Monorepo — Master Environment Variable Template (.env.example)
# Copy this file to .env and adjust values for your local environment
# ─────────────────────────────────────────────────────────────────────────────

# ─── SUPABASE & POSTGRES DATABASE CONFIGURATION ──────────────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Connect to Postgres via the shared transaction-mode pooler (runtime, pgbouncer=true)
DATABASE_URL="postgresql://postgres.ljvrnyatrtbhdunyhfst:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.ljvrnyatrtbhdunyhfst:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ─── SUPABASE CLIENT & SERVER CREDENTIALS ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://ljvrnyatrtbhdunyhfst.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_17KmYFNDZ8QgWwrLDiqAFQ_SjAHBzq9

SUPABASE_URL=https://ljvrnyatrtbhdunyhfst.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_17KmYFNDZ8QgWwrLDiqAFQ_SjAHBzq9
SUPABASE_JWKS_URL=https://ljvrnyatrtbhdunyhfst.supabase.co/auth/v1/.well-known/jwks.json

# ─── REDIS CONFIGURATION ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379

# ─── NESTJS SERVER (API & WEBSOCKET) ──────────────────────────────────────────
PORT=4001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── AUTHENTICATION & JWT SECRETS ────────────────────────────────────────────
# REQUIRED. The server refuses to start if either is missing, shorter than 32
# characters, or if the two are identical (C-05 / C-06). There is no fallback.
#   Generate with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_secure_random_string_32_chars_min
JWT_REFRESH_SECRET=change_me_to_another_secure_random_string_32_chars_min
JWT_EXPIRES_IN=15m
# Lifetime of a refresh-token rotation family, in days.
JWT_REFRESH_EXPIRES_DAYS=30

# ─── CREDIT METERING (BR-01, BR-03) ──────────────────────────────────────────
# Free credits granted per user per day.
DAILY_FREE_CREDITS=100
# Characters covered by one credit; longer text costs ceil(len / this).
TTS_CHARS_PER_CREDIT=200
# Hard cap on a single synthesis request.
TTS_MAX_CHARS=500
# DR-03 — how long a cached audio entry survives without a hit.
TTS_CACHE_TTL_DAYS=30

# ─── TEXT-TO-SPEECH (TTS) ENGINE ──────────────────────────────────────────────
# Q-21 UNRESOLVED — no provider is wired up yet. TtsService.callProvider()
# returns a placeholder URL until a provider is chosen and priced.
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key_here

# ─── NEXT.JS WEB FRONTEND ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4001
# Internal address of the API as seen from the Next.js server (BFF auth
# routes). Inside Docker this is the service name, NOT localhost.
SERVER_API_URL=http://localhost:4001
# Origin of the web app itself — used for the login CSRF origin check.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:4001
NEXT_PUBLIC_LOCAL_BRIDGE_URL=ws://127.0.0.1:4000
